# Copy to .env and fill in. Never commit .env.
# Only the variables needed by the step you're running are validated.

# --- Zilliz Cloud Serverless (indexing, retrieval, app) -----------------
ZILLIZ_URI=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION_PREFIX=research_paper_bot

# --- OpenAI (OpenAI embeddings, RAG generation, LLM judge) --------------
OPENAI_API_KEY=

# --- Embedding models ----------------------------------------------------
EMBEDDING_MODEL_OSS=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_OPENAI=text-embedding-3-small

# --- Ingestion / chunking -------------------------------------------------
DATASET_DIR=./pinnacle_capstone_data
ARTIFACTS_DIR=./artifacts
INGESTION_VERSION=v1
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
# approx_word (offline, deterministic) or tiktoken (exact; downloads a vocab file)
TOKENIZER_BACKEND=approx_word
TOKENIZER_ENCODING_NAME=cl100k_base

# --- Retrieval --------------------------------------------------------------
TOP_K_DENSE=5
# Candidates each ranker (dense, BM25) contributes before fusion / reranking
HYBRID_CANDIDATE_K=20
RERANK_TOP_K=5
# Dense side of hybrid retrieval: oss | openai (pick the winner of the evaluation)
HYBRID_DENSE_BACKEND=oss
# rrf | weighted
FUSION_METHOD=rrf
FUSION_WEIGHT_DENSE=0.5
FUSION_WEIGHT_SPARSE=0.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Generation -------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
